{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/sms.ts": {
      "includeFiles": "rules/**"
    },
    "api/voice.ts": {
      "includeFiles": "rules/**"
    }
  }
}