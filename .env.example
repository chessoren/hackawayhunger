# Server-side only (Vercel → Project → Environment Variables). Never commit real values.
# 32-byte seed, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_SIGNING_SEED=
# Optional: public key baked into the build so verification works offline
VITE_PLATFORM_PUBLIC_KEY=

# Optional SMS/voice channel (Twilio webhook at /api/sms). Bring your own keys.
TWILIO_AUTH_TOKEN=
LLM_PROVIDER=anthropic
LLM_API_KEY=
